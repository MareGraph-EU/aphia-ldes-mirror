@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix dcat: <http://www.w3.org/ns/dcat#>.
@prefix dct: <http://purl.org/dc/terms/>.
@prefix ldes: <https://w3id.org/ldes#>.
@prefix taxon-name: <https://aphia.org/ns/taxon-name/>.
@prefix p-plan: <http://purl.org/net/p-plan#>.
@prefix sds: <https://w3id.org/sds#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

<${SOURCE_LDES_URL}> a sds:Stream;
  p-plan:wasGeneratedBy [
    a p-plan:Activity;
    rdfs:comment """
            Reads the original LDES from https://aphia.org/feed,
            transforms every member into a named graph-based member,
            bucktezes them in a time bucket-based B+Tree structure 
            and writes it into an LDES server data store.
        """;
  ];
  sds:carries [
    a sds:Member;
    sds:shape [
      a sh:NodeShape;
      sh:targetClass taxon-name:TaxonName;
    ];
  ];
  sds:dataset [
    a dcat:Dataset;
    dcat:title "Mirrored Aphia LDES";
    dcat:publisher <http://julianrojas.org#me>;
    ldes:timestampPath dct:modified;
    ldes:versionOfPath dct:isVersionOf;
    dcat:identifier <${LDES_MIRROR_BASE_URL}${LDES_MIRROR_URL_PATH}>;
  ].

