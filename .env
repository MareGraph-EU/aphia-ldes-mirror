LOG_LEVEL=verbose

# LDES Server variables (also used by the RDF-Connect pipeline)
LDES_MIRROR_BASE_URL=http://192.168.0.178:8080
LDES_MIRROR_URL_PATH=/aphia-mirror/ldes
STORE_TYPE=redis
STORE_URL=default:mypassword@redis:6379

# RDF-Connect pipeline exclusive variables
SOURCE_LDES_URL=https://aphia.org/feed
NODE_HEAP_SIZE=4096

# Redis exclusive variables
REDIS_ARGS="--requirepass mypassword"

# Varnish exclusive variables
VARNISH_SIZE=1G
BACKEND_HOST=ldes-server
BACKEND_PORT=3000